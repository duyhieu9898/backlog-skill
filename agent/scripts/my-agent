#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="my-agent"
SERVICE_FILE="${HOME}/.config/systemd/user/${SERVICE_NAME}.service"
BIN_DIR="${HOME}/.local/bin"
BIN_LINK="${BIN_DIR}/my-agent"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
AGENT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
NPM_BIN="${NPM_BIN:-$(command -v npm)}"
NODE_BIN="${NODE_BIN:-$(command -v node)}"
NODE_DIR="$(dirname "${NODE_BIN}")"

usage() {
  cat <<EOF
Usage: my-agent <command>

Commands:
  install       Install Linux/X11 desktop prerequisites, CLI symlink, and systemd user service
  uninstall     Stop and remove systemd user service
  start         Start background agent service
  stop          Stop background agent service
  restart       Restart background agent service
  status        Show service status
  logs          Follow service logs
  clear-logs    FULL WIPE → fresh session: stop service, delete data/agent.sqlite + data/artifacts/* + logs + eval/eval.sqlite + eval/reports/* (keeps .env/config/code/skills/eval spec), then restart the service. Irreversible. Use -y/--force to skip the prompt
  run           Run a prompt locally and print trace/artifact JSON; does not send Telegram
EOF
}

LINUX_X11_DESKTOP_PACKAGES=(scrot libgtk-3-bin xdotool wmctrl python3-pyatspi)

desktop_prerequisites_ready() {
  command -v scrot >/dev/null 2>&1 &&
    command -v gtk-launch >/dev/null 2>&1 &&
    command -v xdotool >/dev/null 2>&1 &&
    command -v wmctrl >/dev/null 2>&1 &&
    python3 -c 'import pyatspi' >/dev/null 2>&1
}

install_linux_x11_desktop_dependencies() {
  if [[ "${MY_AGENT_SKIP_DESKTOP_DEPS:-0}" == "1" ]]; then
    echo "Skipping desktop prerequisites because MY_AGENT_SKIP_DESKTOP_DEPS=1."
    return
  fi

  if [[ "$(uname -s)" != "Linux" ]]; then
    echo "Skipping Linux/X11 desktop prerequisites on $(uname -s)."
    return
  fi

  if desktop_prerequisites_ready; then
    echo "Linux/X11 desktop prerequisites already installed."
    return
  fi

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "Linux/X11 desktop automation requires: ${LINUX_X11_DESKTOP_PACKAGES[*]}" >&2
    echo "Automatic installation currently supports Debian/Ubuntu through apt-get." >&2
    return 1
  fi
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Linux/X11 desktop prerequisites." >&2
    return 1
  fi

  echo "Installing Linux/X11 desktop prerequisites: ${LINUX_X11_DESKTOP_PACKAGES[*]}"
  sudo apt-get update
  sudo apt-get install -y "${LINUX_X11_DESKTOP_PACKAGES[@]}"

  if ! desktop_prerequisites_ready; then
    echo "Linux/X11 desktop prerequisites are still unavailable after installation." >&2
    return 1
  fi
}

import_desktop_environment() {
  local names=()
  local name
  for name in DISPLAY XAUTHORITY XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS; do
    if [[ -n "${!name:-}" ]]; then
      names+=("${name}")
    fi
  done
  if (( ${#names[@]} > 0 )); then
    systemctl --user import-environment "${names[@]}"
  fi
}

write_service() {
  mkdir -p "$(dirname "${SERVICE_FILE}")"
  cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=My Agent Telegram orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${AGENT_DIR}
ExecStart=${NPM_BIN} run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=${NODE_DIR}:/usr/local/bin:/usr/bin:/bin
Environment="NODE_OPTIONS=--no-network-family-autoselection --dns-result-order=ipv4first"

[Install]
WantedBy=default.target
EOF
}

install_cli() {
  mkdir -p "${BIN_DIR}"
  ln -sfn "${SCRIPT_PATH}" "${BIN_LINK}"
}

install_service() {
  import_desktop_environment
  write_service
  systemctl --user daemon-reload
  systemctl --user enable "${SERVICE_NAME}.service"
}

ensure_installed() {
  if [[ ! -f "${SERVICE_FILE}" ]]; then
    install_cli
    install_service
  fi
}

# Linger keeps the user systemd manager (and my-agent.service) running after
# logout/reboot. It is a user-wide setting, so install/uninstall toggle it as a
# best-effort step rather than failing the whole command on a polkit quirk.
enable_linger() {
  if ! command -v loginctl >/dev/null 2>&1; then
    echo "loginctl not found; the service will only run while you are logged in." >&2
    return
  fi
  if loginctl enable-linger "${USER}" 2>/dev/null; then
    echo "Enabled linger for ${USER} — service runs after logout/reboot."
  else
    echo "Could not enable linger; the service will only run while logged in." >&2
  fi
}

disable_linger() {
  if command -v loginctl >/dev/null 2>&1 && loginctl show-user "${USER}" 2>/dev/null | grep -q "^Linger=yes"; then
    loginctl disable-linger "${USER}" 2>/dev/null || true
    echo "Disabled linger for ${USER} (user-wide)."
  fi
}

# Verify a just-started service actually booted. systemd Type=simple marks the
# unit "active" the moment ExecStart launches, before the agent finishes booting
# (Telegram connect, DB open); Restart=always would then mask a boot-time crash
# as an active state. So: wait for a terminal state, settle a few seconds to let
# a boot-time crash surface, then assert still-active + zero restarts.
wait_healthy() {
  local svc="$1"
  if ! systemctl --user is-active --wait "$svc" >/dev/null 2>&1; then
    echo "Service did not reach active state." >&2
    systemctl --user --no-pager --lines=20 status "$svc" >&2
    return 1
  fi
  sleep 3
  local state restarts
  state=$(systemctl --user is-active "$svc" 2>/dev/null || true)
  restarts=$(systemctl --user show "$svc" -p NRestarts --value 2>/dev/null || echo 0)
  if [[ "$state" != "active" ]] || [[ "$restarts" -gt 0 ]]; then
    echo "Service unhealthy after start (state=${state}, restarts=${restarts}) — likely crash-looping." >&2
    systemctl --user --no-pager --lines=20 status "$svc" >&2
    return 1
  fi
  systemctl --user --no-pager --lines=5 status "$svc"
  echo "Agent active."
}

clear_logs() {
  local force=0
  if [[ "${2:-}" == "-y" || "${2:-}" == "--force" ]]; then force=1; fi

  echo "FULL WIPE under ${AGENT_DIR} — the agent starts with a FRESH session:"
  echo "  - stop service ${SERVICE_NAME} (releases the DB connection)"
  echo "  - delete data/agent.sqlite (+wal/shm) — chat history, runs, run_steps, command_runs, trace_events, approvals, schedules, sessions, artifact metadata"
  echo "  - delete data/artifacts/* — all generated images/files"
  echo "  - truncate logs/agent.log, remove logs/ai-interactions/*"
  echo "  - delete eval/eval.sqlite + eval/reports/* (keeps eval/real-trace.json spec)"
  echo "  - vacuum the systemd journal, then restart the service (opens a fresh DB)"
  echo "KEPT: .env, config.json, commands.json, code (src/dist/scripts/skills), systemd unit, git."

  if (( ! force )); then
    if [[ ! -t 0 ]]; then
      echo "Refusing to wipe non-interactively without -y/--force." >&2
      exit 1
    fi
    read -r -p "This deletes ALL state incl. chat history (irreversible). Proceed? [y/N] " ans
    if [[ "${ans:-}" != "y" && "${ans:-}" != "Y" ]]; then
      echo "Aborted."
      exit 0
    fi
  fi

  # Stop the service so it releases the DB; it reopens a fresh one on restart.
  systemctl --user stop "${SERVICE_NAME}.service" 2>/dev/null || true

  # State: production DB (recreated fresh by getDb on next start) + artifacts.
  rm -f "${AGENT_DIR}/data/agent.sqlite" "${AGENT_DIR}/data/agent.sqlite-wal" "${AGENT_DIR}/data/agent.sqlite-shm"
  rm -rf "${AGENT_DIR}/data/artifacts"/* 2>/dev/null || true
  # Logs.
  : > "${AGENT_DIR}/logs/agent.log" 2>/dev/null || true
  rm -rf "${AGENT_DIR}/logs/ai-interactions"/* 2>/dev/null || true
  # Eval (keep the real-trace.json spec).
  rm -f "${AGENT_DIR}/eval/eval.sqlite" "${AGENT_DIR}/eval/eval.sqlite-wal" "${AGENT_DIR}/eval/eval.sqlite-shm"
  rm -rf "${AGENT_DIR}/eval/reports"/* 2>/dev/null || true
  # Service journal.
  journalctl --user --vacuum-time=1s 2>/dev/null || true

  # Restart so the service opens a fresh agent.sqlite (new session).
  if systemctl --user start "${SERVICE_NAME}.service" 2>/dev/null; then
    echo "Wiped + service restarted. Agent starts fresh on next message."
  else
    echo "Wiped. Service not started (not installed?) — run \`my-agent start\` when ready."
  fi
}

case "${1:-}" in
  install)
    install_linux_x11_desktop_dependencies
    install_cli
    install_service
    enable_linger
    echo "Installed ${SERVICE_FILE}"
    echo "Installed ${BIN_LINK}"
    ;;
  uninstall)
    systemctl --user stop "${SERVICE_NAME}.service" 2>/dev/null || true
    systemctl --user disable "${SERVICE_NAME}.service" 2>/dev/null || true
    rm -f "${SERVICE_FILE}"
    systemctl --user daemon-reload
    if [[ -L "${BIN_LINK}" && "$(readlink -f "${BIN_LINK}")" == "${SCRIPT_PATH}" ]]; then
      rm -f "${BIN_LINK}"
    fi
    disable_linger
    echo "Uninstalled ${SERVICE_NAME}"
    ;;
  start)
    ensure_installed
    systemctl --user start "${SERVICE_NAME}.service"
    wait_healthy "${SERVICE_NAME}.service" || exit 1
    ;;
  stop)
    systemctl --user stop "${SERVICE_NAME}.service"
    ;;
  restart)
    ensure_installed
    systemctl --user restart "${SERVICE_NAME}.service"
    wait_healthy "${SERVICE_NAME}.service" || exit 1
    ;;
  run)
    shift
    exec "${NODE_BIN}" "${AGENT_DIR}/dist/cli.js" --json "$@"
    ;;
  status)
    systemctl --user --no-pager status "${SERVICE_NAME}.service"
    ;;
  logs)
    journalctl --user -u "${SERVICE_NAME}.service" -f
    ;;
  clear-logs)
    clear_logs "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
