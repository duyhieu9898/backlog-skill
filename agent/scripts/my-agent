#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="my-agent"
SERVICE_FILE="${HOME}/.config/systemd/user/${SERVICE_NAME}.service"
BIN_DIR="${HOME}/.local/bin"
BIN_LINK="${BIN_DIR}/my-agent"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
AGENT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
NPM_BIN="${NPM_BIN:-$(command -v npm)}"
NODE_BIN="${NODE_BIN:-$(command -v node)}"
NODE_DIR="$(dirname "${NODE_BIN}")"

usage() {
  cat <<EOF
Usage: my-agent <command>

Commands:
  install       Install Linux/X11 desktop prerequisites, CLI symlink, and systemd user service
  desktop-deps  Install Linux/X11 desktop automation prerequisites only
  uninstall     Stop and remove systemd user service
  start         Start background agent service
  stop          Stop background agent service
  restart       Restart background agent service
  status        Show service status
  logs          Follow service logs
  web-smoke     Capture https://example.com/ in headless Chrome and send it to Telegram
  run           Run a prompt locally and print trace/artifact JSON; does not send Telegram
  enable-login  Keep user services running after logout
EOF
}

LINUX_X11_DESKTOP_PACKAGES=(scrot libgtk-3-bin xdotool wmctrl python3-pyatspi)

desktop_prerequisites_ready() {
  command -v scrot >/dev/null 2>&1 &&
    command -v gtk-launch >/dev/null 2>&1 &&
    command -v xdotool >/dev/null 2>&1 &&
    command -v wmctrl >/dev/null 2>&1 &&
    python3 -c 'import pyatspi' >/dev/null 2>&1
}

install_linux_x11_desktop_dependencies() {
  if [[ "${MY_AGENT_SKIP_DESKTOP_DEPS:-0}" == "1" ]]; then
    echo "Skipping desktop prerequisites because MY_AGENT_SKIP_DESKTOP_DEPS=1."
    return
  fi

  if [[ "$(uname -s)" != "Linux" ]]; then
    echo "Skipping Linux/X11 desktop prerequisites on $(uname -s)."
    return
  fi

  if desktop_prerequisites_ready; then
    echo "Linux/X11 desktop prerequisites already installed."
    return
  fi

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "Linux/X11 desktop automation requires: ${LINUX_X11_DESKTOP_PACKAGES[*]}" >&2
    echo "Automatic installation currently supports Debian/Ubuntu through apt-get." >&2
    return 1
  fi
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Linux/X11 desktop prerequisites." >&2
    return 1
  fi

  echo "Installing Linux/X11 desktop prerequisites: ${LINUX_X11_DESKTOP_PACKAGES[*]}"
  sudo apt-get update
  sudo apt-get install -y "${LINUX_X11_DESKTOP_PACKAGES[@]}"

  if ! desktop_prerequisites_ready; then
    echo "Linux/X11 desktop prerequisites are still unavailable after installation." >&2
    return 1
  fi
}

import_desktop_environment() {
  local names=()
  local name
  for name in DISPLAY XAUTHORITY XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS; do
    if [[ -n "${!name:-}" ]]; then
      names+=("${name}")
    fi
  done
  if (( ${#names[@]} > 0 )); then
    systemctl --user import-environment "${names[@]}"
  fi
}

write_service() {
  mkdir -p "$(dirname "${SERVICE_FILE}")"
  cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=My Agent Telegram orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${AGENT_DIR}
ExecStart=${NPM_BIN} run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=${NODE_DIR}:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
EOF
}

install_cli() {
  mkdir -p "${BIN_DIR}"
  ln -sfn "${SCRIPT_PATH}" "${BIN_LINK}"
}

install_service() {
  import_desktop_environment
  write_service
  systemctl --user daemon-reload
  systemctl --user enable "${SERVICE_NAME}.service"
}

ensure_installed() {
  if [[ ! -f "${SERVICE_FILE}" ]]; then
    install_cli
    install_service
  fi
}

case "${1:-}" in
  install)
    install_linux_x11_desktop_dependencies
    install_cli
    install_service
    echo "Installed ${SERVICE_FILE}"
    echo "Installed ${BIN_LINK}"
    ;;
  desktop-deps)
    install_linux_x11_desktop_dependencies
    ;;
  uninstall)
    systemctl --user stop "${SERVICE_NAME}.service" 2>/dev/null || true
    systemctl --user disable "${SERVICE_NAME}.service" 2>/dev/null || true
    rm -f "${SERVICE_FILE}"
    systemctl --user daemon-reload
    if [[ -L "${BIN_LINK}" && "$(readlink -f "${BIN_LINK}")" == "${SCRIPT_PATH}" ]]; then
      rm -f "${BIN_LINK}"
    fi
    echo "Uninstalled ${SERVICE_NAME}"
    ;;
  start)
    ensure_installed
    systemctl --user start "${SERVICE_NAME}.service"
    systemctl --user --no-pager --lines=0 status "${SERVICE_NAME}.service"
    ;;
  stop)
    systemctl --user stop "${SERVICE_NAME}.service"
    ;;
  restart)
    ensure_installed
    systemctl --user restart "${SERVICE_NAME}.service"
    systemctl --user --no-pager --lines=0 status "${SERVICE_NAME}.service"
    ;;
  web-smoke)
    exec "${NODE_BIN}" "${AGENT_DIR}/scripts/web-capture-smoke.js"
    ;;
  run)
    shift
    exec "${NODE_BIN}" "${AGENT_DIR}/dist/cli.js" --json "$@"
    ;;
  status)
    systemctl --user --no-pager status "${SERVICE_NAME}.service"
    ;;
  logs)
    journalctl --user -u "${SERVICE_NAME}.service" -f
    ;;
  enable-login)
    loginctl enable-linger "${USER}"
    echo "Enabled linger for ${USER}"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
