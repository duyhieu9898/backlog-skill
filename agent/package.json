{
  "name": "agent",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram command router for local agents",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "npm run build && node dist/bot.js",
    "cli": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/*.test.js",
    "verify": "npm run test && git diff --check && git diff --cached --check",
    "smoke:gemini": "node scripts/dev.js smoke gemini",
    "ai-logs": "node scripts/dev.js logs",
    "eval:diff": "node scripts/dev.js eval diff",
    "smoke:telegram-media": "npm run build && node scripts/dev.js smoke telegram",
    "smoke:web": "node scripts/dev.js smoke web",
    "eval": "npm run build && node scripts/dev.js eval"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "better-sqlite3": "^12.10.0",
    "croner": "^10.0.1",
    "openai": "^6.39.0",
    "playwright": "^1.61.1"
  }
}
